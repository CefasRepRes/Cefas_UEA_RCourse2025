head(unlist(numbersmultiplied))

```

## Passing packages

If you use a specific function you will need to pass the packages to the for loop to be sent to the 'children'

```{r, warning = FALSE}

library(tidyverse)

df_maker <- function(aaaa){
  
  df <- data.frame(numbers = c(aaaa,2,3,4,5,6,7))
  
  return(df)
  
}


# Here we pass the package
foreach(i=1:3,
        .packages=c('dplyr', "vegan")) %dopar% {
  
  a_df <- df_maker(i)
  
  a_df %>% 
    filter(numbers < i+3)
  
}



```

# A quick bit on apply

## (and parallel lapply)

Maybe we don't need to paralellize, in R there are another group of functions we can use to speed up our code!

(<https://ademos.people.uic.edu/Chapter4.html>)

```{r}

?apply()

# getting only numeric data from mtcars
get_names = names(mtcars)[sapply(mtcars, is.numeric)]
df = mtcars[,get_names]

df

```

Look at rows and columns with apply

```{r}

apply(df,   # our data frame from above!
      1,    # index 1, this means rows
      sum)  # sum = sum 


# now columns
apply(df, 2, sum)

apply(df, 2, mean)


```

Using custom functions

```{r}

# dont forget 2 = columns

apply(df, 2,
      function (x) length(x) - 1)



```

Or adding a function in from outside the apply:

```{r}



st.err <- function(x){
  sd(x)/sqrt(length(x))
}





apply(df,
      2, 
      st.err)

```

### lapply and sapply

```{r}
A<-c(1:9)
B<-c(1:12)
C<-c(1:15)

my.lst<-list(A,B,C)

lapply(my.lst, sum)

# using our own function
lapply(my.lst, st.err)

# Simple output as a vector
sapply(my.lst, sum)

```

## parLapply from parallel package 

```{r}

cl <- parallel::makeCluster(18)
doParallel::registerDoParallel(cl)


f <- function(x){
    Sys.sleep(.3)
    dexp(x, 2)
}

num_list <- c(1:10)

parLapply(cl, num_list, f)


```

### Quick benchmark test

```{r}

microbenchmark(
  # writing the code for the normal loop
  'lapply' = lapply(num_list, f),
  # writing the code for the par loop
  'parLapply' = parLapply(cl, num_list, f),
  times=2)


```

