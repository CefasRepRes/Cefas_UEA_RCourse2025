# OH NO!

### It is really tricky to show an example where code will be sped up by parallel processing without taking up the whole hour! It is more useful when you doing big operations

An example:

(<https://stackoverflow.com/questions/53054366/how-can-i-run-a-for-loop-in-parallel-in-r>)

```{r}

cl <- parallel::makeCluster(18)
doParallel::registerDoParallel(cl)


f <- function(x) dexp(x, 2)
d <- runif(10, 1, 5)
dnew <- numeric(length(d))

dnew2 <- f(d)

dnew3 <- foreach(i=seq_along(dnew), .combine=c) %dopar% {
    f(d[i])
}

f <- function(x){
    Sys.sleep(.3)
    dexp(x, 2)
}

microbenchmark(
  # writing the code for the normal loop
  'for loop' = for (i in seq_along(dnew))
    {
    dnew[i] <- f(d[i])
    },
  # writing the code for the par loop
  'foreach' = {
    dnew3 <- foreach(i=seq_along(dnew),
                     .combine=c) %dopar% 
      {
        f(d[i])
        }
    },
  times=2)



```

